# Non-secret configuration only. Merge these entries; preserve all GHN entries.
PAYMENT_PROVIDER=VNPAY
VNPAY_ENV=sandbox
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://us-central1-fashion2hand.cloudfunctions.net/vnpayReturn
# QueryDR: optional VNPAY_QUERY_IP override for a verified fixed server egress IP.
# On Cloud Run sandbox, an unset value is discovered over HTTPS via api.ipify.org.
# Lookup failures leave the result pending; they never mark the order paid/failed.
# No fake/default IP. Do not enable paid NAT or any service automatically.
# VNPAY_TMN_CODE and VNPAY_HASH_SECRET belong in Firebase Secrets, never here.

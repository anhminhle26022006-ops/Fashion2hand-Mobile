{
  "name": "fashion2hand-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "test:admin": "node --test test/admin.emulator.test.js",
    "test:transactions": "node --test test/transactions.emulator.test.js",
    "test:marketplace": "node --test test/marketplace.emulator.test.js",
    "serve": "firebase emulators:start --only functions,firestore",
    "serve:team": "firebase emulators:start --only auth,firestore,functions,storage --export-on-exit=../emulator-data",
    "seed:emulator": "node seed-emulator.js",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.2"
  }
}

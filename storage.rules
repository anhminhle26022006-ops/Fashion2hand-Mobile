rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function ownsPost(postId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/posts/$(postId)).data.ownerId == request.auth.uid;
    }

    match /posts/{postId}/images/{fileName} {
      allow read: if firestore.get(/databases/(default)/documents/posts/$(postId)).data.status == 'ACTIVE'
        || ownsPost(postId);
      allow create, update: if ownsPost(postId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if ownsPost(postId);
    }

    match /users/{uid}/avatar/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}

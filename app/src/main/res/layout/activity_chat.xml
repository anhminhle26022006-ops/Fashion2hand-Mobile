<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F6F0">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:background="#F9F6F0">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="#111111" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgChatAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/img_avatar_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvChatName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang tải thành viên…"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_verified" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tin nhắn đồng bộ từ backend"
                android:textSize="12sp"
                android:textColor="#2ECC71"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_more_horiz"
            app:tint="#111111" />
    </LinearLayout>

    <!-- PRODUCT PIN CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_white_card_rounded"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:padding="12dp"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgPinnedProduct"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_product_placeholder"
                android:background="@drawable/bg_search_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SẢN PHẨM ĐANG TRAO ĐỔI"
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPinnedProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vintage Denim Jacket"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvPinnedProductPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="120.000 đ"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E67E22"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="#555555" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EFECE6"
            android:layout_marginVertical="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddToCart"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Thêm vào giỏ"
                android:textSize="13sp"
                android:textColor="#111111"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_outline"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnBuyNow"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Mua ngay"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_primary"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvMessageState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:text="Đang tải tin nhắn…"
        android:textColor="#52645A" />

    <Button
        android:id="@+id/btnOlderMessages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tải tin nhắn trước"
        android:textAllCaps="false"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatMessagesContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp" />

    <!-- BOTTOM CHAT BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="#F9F6F0"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnAttach"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_camera"
            app:tint="#444444" />

        <EditText
            android:id="@+id/edtMessageInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_chat_input"
            android:hint="Nhắn tin..."
            android:textSize="14sp"
            android:textColor="#111111"
            android:textColorHint="#888888"
            android:paddingHorizontal="16dp"
            android:inputType="textLongMessage|textCapSentences" />

        <ImageView
            android:id="@+id/btnSendMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_primary"
            android:padding="11dp"
            android:src="@drawable/ic_send"
            app:tint="@android:color/white" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/f2h_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_admin_round"
            android:backgroundTint="@color/f2h_primary"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:src="@drawable/ic_admin_shield"
            android:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:text="FASHION2HAND · ADMIN"
            android:textColor="@color/f2h_primary_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Đăng nhập quản trị"
            android:textColor="@color/f2h_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Khu vực riêng cho quản trị viên. Hệ thống kiểm tra vai trò (role) của tài khoản trước khi cho vào."
            android:textColor="@color/f2h_text_muted"
            android:textSize="14sp" />

        <TextView
            style="@style/AdminLabel"
            android:layout_marginTop="28dp"
            android:text="Email" />

        <EditText
            android:id="@+id/edtAdminEmail"
            style="@style/AdminInput"
            android:hint="Email được cấp quyền quản trị"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/AdminLabel"
            android:text="Mật khẩu" />

        <EditText
            android:id="@+id/edtAdminPassword"
            style="@style/AdminInput"
            android:hint="Nhập mật khẩu"
            android:saveEnabled="false"
            android:inputType="textPassword" />

        <CheckBox
            android:id="@+id/checkShowAdminPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Hiện mật khẩu"
            android:textColor="@color/f2h_text_muted" />

        <TextView
            android:id="@+id/btnAdminLogin"
            style="@style/AdminButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:layout_weight="0"
            android:background="@drawable/bg_admin_btn_primary"
            android:text="Đăng nhập"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/txtAdminDemoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_admin_notice"
            android:backgroundTint="@color/f2h_info_soft"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:text="Đăng nhập bằng tài khoản Firebase được cấp quyền Admin. Quyền truy cập được kiểm tra tại backend."
            android:textColor="@color/f2h_info"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnBackToUserApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="14dp"
            android:text="Quay lại ứng dụng người dùng"
            android:textColor="@color/f2h_primary_light"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

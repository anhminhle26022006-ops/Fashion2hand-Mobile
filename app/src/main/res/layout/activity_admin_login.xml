<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:background="#F8F6F0" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FASHION2HAND  ·  ADMIN" android:textColor="#23795C" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Đăng nhập quản trị" android:textColor="#173B32" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="Khu vực dành riêng cho quản trị viên." android:textColor="#75857F" android:textSize="14sp" />
    <EditText android:id="@+id/edtAdminEmail" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_form_input" android:hint="Email quản trị" android:inputType="textEmailAddress" android:paddingHorizontal="16dp" android:text="admin@fashion2hand.com" android:textColor="#173B32" />
    <EditText android:id="@+id/edtAdminPassword" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_form_input" android:hint="Mật khẩu" android:inputType="textPassword" android:paddingHorizontal="16dp" android:textColor="#173B32" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tài khoản demo: admin@fashion2hand.com · nhập mật khẩu bất kỳ" android:textColor="#75857F" android:textSize="12sp" />
    <Button android:id="@+id/btnAdminLogin" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:backgroundTint="#23795C" android:text="Đăng nhập Admin" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    <TextView android:id="@+id/btnAdminLoginBack" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Quay lại đăng nhập người dùng" android:textColor="#23795C" android:textSize="14sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F7F2">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingHorizontal="12dp"><TextView android:id="@+id/btnPaymentInfoBack" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="#183C32" android:textSize="30sp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Thông tin nhận thanh toán" android:textColor="#183C32" android:textSize="14sp" android:textStyle="bold"/><View android:layout_width="40dp" android:layout_height="40dp"/></LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="11dp" android:background="#FFF5E6"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dành cho người bán / người nhận hỗ trợ" android:textColor="#8F632C" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Dùng riêng để chuyển tiền hoặc hoàn tiền. Không nhập mật khẩu ngân hàng, mã OTP hay mã bảo mật thẻ." android:textColor="#977F5E" android:textSize="8sp"/></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Ngân hàng" android:textColor="#183C32" android:textSize="9sp" android:textStyle="bold"/><Spinner android:id="@+id/spinnerPayoutBank" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="5dp" android:background="@drawable/bg_white_card_rounded" android:paddingHorizontal="9dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:text="Tên chủ tài khoản" android:textColor="#183C32" android:textSize="9sp" android:textStyle="bold"/><EditText android:id="@+id/edtPayoutHolder" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:background="@drawable/bg_white_card_rounded" android:hint="Tên như trên tài khoản" android:inputType="textCapCharacters" android:paddingHorizontal="12dp" android:textColor="#183C32" android:textSize="10sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:text="Số tài khoản" android:textColor="#183C32" android:textSize="9sp" android:textStyle="bold"/><EditText android:id="@+id/edtPayoutAccountNumber" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:background="@drawable/bg_white_card_rounded" android:hint="Nhập số tài khoản" android:inputType="number" android:paddingHorizontal="12dp" android:textColor="#183C32" android:textSize="10sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="11dp" android:background="#EDF4EF"><TextView android:id="@+id/txtPayoutStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ⓘ  Chưa xác minh tài khoản nhận tiền" android:textColor="#104536" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:layout_marginTop="4dp" android:text="Tên chủ tài khoản sẽ được đối chiếu trước khi chuyển tiền." android:textColor="#87938D" android:textSize="8sp"/></LinearLayout>
        <CheckBox android:id="@+id/checkPayoutConsent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:buttonTint="#104536" android:text="Tôi xác nhận đây là tài khoản của mình và đồng ý dùng thông tin này cho giao dịch nhận tiền." android:textColor="#52645A" android:textSize="8sp"/>
        <Button android:id="@+id/btnSavePayoutInfo" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:backgroundTint="#104536" android:text="Lưu tài khoản nhận tiền" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
    </LinearLayout></ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0" android:padding="22dp">
    <TextView android:id="@+id/btnNewPasswordBack" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginTop="20dp" android:gravity="center" android:text="‹" android:textColor="#173B32" android:textSize="28sp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="BẢO MẬT TÀI KHOẢN" android:textColor="#E97859" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Tạo mật khẩu mới" android:textColor="#102F27" android:textSize="25sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:text="Chọn mật khẩu mới có ít nhất 6 ký tự." android:textColor="#75857F" android:textSize="10sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mật khẩu mới" android:textColor="#173B32" android:textSize="9sp" android:textStyle="bold" />
    <EditText android:id="@+id/edtNewPassword" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_white_card_rounded" android:hint="Nhập mật khẩu mới" android:inputType="textPassword" android:paddingHorizontal="13dp" android:textColor="#173B32" android:textSize="11sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Nhập lại mật khẩu" android:textColor="#173B32" android:textSize="9sp" android:textStyle="bold" />
    <EditText android:id="@+id/edtConfirmNewPassword" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_white_card_rounded" android:hint="Nhập lại mật khẩu mới" android:inputType="textPassword" android:paddingHorizontal="13dp" android:textColor="#173B32" android:textSize="11sp" />
    <Button android:id="@+id/btnSaveNewPassword" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="22dp" android:backgroundTint="#104536" android:text="Cập nhật mật khẩu" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F6F0" android:fillViewport="true" android:clipToPadding="false"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
    <TextView android:id="@+id/btnOtpBack" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginTop="20dp" android:gravity="center" android:text="‹" android:textColor="#173B32" android:textSize="28sp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="XÁC THỰC TÀI KHOẢN" android:textColor="#E97859" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtOtpTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Nhập mã xác thực" android:textColor="#102F27" android:textSize="25sp" />
    <TextView android:id="@+id/txtOtpDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Mã xác thực đã được gửi đến email của bạn." android:textColor="#75857F" android:textSize="10sp" />
    <TextView android:id="@+id/txtOtpTarget" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#173B32" android:textSize="10sp" android:textStyle="bold" />
    <EditText android:id="@+id/edtOtpCode" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:background="@drawable/bg_white_card_rounded" android:gravity="center" android:hint="•  •  •  •  •  •" android:inputType="number" android:maxLength="6" android:letterSpacing="0.35" android:textColor="#173B32" android:textSize="20sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mã chỉ có hiệu lực trong phiên xác minh do Firebase cấp." android:textColor="#87938D" android:textSize="8sp" />
    <Button android:id="@+id/btnSubmitOtp" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:backgroundTint="#104536" android:text="Xác nhận" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
    <TextView android:id="@+id/btnResendOtp" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:gravity="center" android:text="Gửi lại mã" android:textColor="#23795C" android:textSize="10sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
</LinearLayout></ScrollView>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="#FFFFFF">
    <TextView android:id="@+id/btnTransactionBack" android:layout_width="44dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="#173B32" android:contentDescription="Quay lại" android:clickable="true" android:focusable="true"/>
    <TextView android:id="@+id/txtTransactionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Trung tâm giao dịch" android:textColor="#173B32" android:textSize="18sp"/>
    <TextView android:id="@+id/btnTransactionHistory" android:layout_width="44dp" android:layout_height="40dp" android:gravity="center" android:background="@drawable/bg_transaction_card" android:text="↺" android:textColor="#173B32" android:textSize="24sp" android:contentDescription="Lịch sử giao dịch" android:clickable="true" android:focusable="true"/>
</LinearLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F7F2">
    <include layout="@layout/view_transaction_header"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6E9E3"/>
    <RadioGroup android:id="@+id/historyFilters" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:orientation="horizontal" android:padding="4dp" android:background="@drawable/bg_transaction_tabs">
        <RadioButton android:id="@+id/filterHistoryAll" style="@style/TransactionSegment" android:text="Tất cả" android:checked="true"/>
        <RadioButton android:id="@+id/filterHistoryBuy" style="@style/TransactionSegment" android:text="Mua"/>
        <RadioButton android:id="@+id/filterHistorySell" style="@style/TransactionSegment" android:text="Bán"/>
        <RadioButton android:id="@+id/filterHistoryFree" style="@style/TransactionSegment" android:text="Chia sẻ miễn phí" android:textSize="10sp"/>
    </RadioGroup>
    <TextView android:id="@+id/historyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingBottom="8dp" android:text="Đang tải lịch sử…" android:textColor="#65776D" android:textSize="12sp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/transactionHistoryList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="16dp" android:paddingBottom="20dp" android:clipToPadding="false"/>
</LinearLayout>
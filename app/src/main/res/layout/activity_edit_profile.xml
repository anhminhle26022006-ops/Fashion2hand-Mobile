<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <TextView android:id="@+id/btnEditProfileBack" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="#183C32" android:textSize="30sp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Chỉnh sửa hồ sơ" android:textColor="#183C32" android:textSize="15sp" android:textStyle="bold"/>
        <View android:layout_width="40dp" android:layout_height="40dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="126dp" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/txtEditProfileAvatar" android:layout_width="76dp" android:layout_height="76dp" android:gravity="center" android:text="MA" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:background="@drawable/bg_circle_primary"/>
                <TextView android:id="@+id/btnChangeProfilePhoto" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center" android:text="▣  Đổi ảnh" android:textColor="#104536" android:textSize="11sp" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Họ và tên" android:textColor="#173B32" android:textSize="10sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtProfileName" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:layout_marginBottom="11dp" android:background="@drawable/bg_white_card_rounded" android:hint="Họ và tên hiển thị" android:paddingHorizontal="13dp" android:text="Nguyễn Minh Anh" android:textColor="#173B32" android:textSize="11sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Giới tính (không bắt buộc)" android:textColor="#173B32" android:textSize="10sp" android:textStyle="bold"/>
            <Spinner android:id="@+id/spinnerProfileGender" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:layout_marginBottom="11dp" android:background="@drawable/bg_white_card_rounded" android:paddingHorizontal="10dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ngày sinh" android:textColor="#173B32" android:textSize="10sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtProfileBirthDate" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:layout_marginBottom="11dp" android:background="@drawable/bg_white_card_rounded" android:hint="dd/mm/yyyy" android:inputType="date" android:paddingHorizontal="13dp" android:textColor="#173B32" android:textSize="11sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Khu vực hiển thị" android:textColor="#173B32" android:textSize="10sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtProfileRegion" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:layout_marginBottom="11dp" android:background="@drawable/bg_white_card_rounded" android:hint="Quận / huyện, tỉnh / thành phố" android:paddingHorizontal="13dp" android:text="Quận 3, TP.HCM" android:textColor="#173B32" android:textSize="11sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Địa chỉ giao hàng mặc định (riêng tư)" android:textColor="#173B32" android:textSize="10sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtProfileAddress" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:layout_marginBottom="11dp" android:background="@drawable/bg_white_card_rounded" android:hint="Chỉ dùng khi bạn đặt đơn" android:inputType="textPostalAddress" android:paddingHorizontal="13dp" android:textColor="#173B32" android:textSize="11sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Giới thiệu" android:textColor="#173B32" android:textSize="10sp" android:textStyle="bold"/>
            <EditText android:id="@+id/edtProfileBio" android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginTop="6dp" android:layout_marginBottom="11dp" android:background="@drawable/bg_white_card_rounded" android:gravity="top|start" android:hint="Giới thiệu ngắn về bạn" android:inputType="textCapSentences|textMultiLine" android:padding="13dp" android:text="Yêu thời trang bền vững và những món đồ có câu chuyện." android:textColor="#173B32" android:textSize="11sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical" android:padding="11dp" android:background="#EDF4EF">
                <TextView android:id="@+id/txtProfileEmailStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓  Email đã xác minh" android:textColor="#104536" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:id="@+id/txtProfileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="3dp" android:text="minhanh.demo@email.com" android:textColor="#87938D" android:textSize="8sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="5dp" android:text="Email xác nhận bằng mã gửi đến hộp thư" android:textColor="#87938D" android:textSize="7sp"/>
                <Button android:id="@+id/btnChangeProfileEmail" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="17dp" android:layout_marginTop="2dp" android:backgroundTint="#FFFFFF" android:text="Đổi email" android:textAllCaps="false" android:textColor="#104536" android:textSize="8sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="11dp" android:background="#EDF4EF">
                <TextView android:id="@+id/txtProfilePhoneStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓  Số điện thoại đã xác minh" android:textColor="#104536" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:id="@+id/txtProfilePhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="3dp" android:text="0901 234 567" android:textColor="#87938D" android:textSize="8sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <Button android:id="@+id/btnVerifyPhone" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="17dp" android:layout_marginTop="3dp" android:backgroundTint="#FFFFFF" android:text="Xác minh bằng OTP" android:textAllCaps="false" android:textColor="#104536" android:textSize="8sp"/>
                    <Button android:id="@+id/btnChangeProfilePhone" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="5dp" android:layout_marginTop="3dp" android:backgroundTint="#FFFFFF" android:text="Đổi số" android:textAllCaps="false" android:textColor="#104536" android:textSize="8sp"/>
                </LinearLayout>
            </LinearLayout>
            <Button android:id="@+id/btnEditProfileSave" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="13dp" android:backgroundTint="#104536" android:text="Lưu thay đổi" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
            <Button android:id="@+id/btnEditProfileVerify" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" android:backgroundTint="#FFFFFF" android:text="Xác minh danh tính" android:textAllCaps="false" android:textColor="#104536"/>
            <Button android:id="@+id/btnEditProfilePayment" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:backgroundTint="#FFFFFF" android:text="Thông tin nhận thanh toán" android:textAllCaps="false" android:textColor="#104536"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

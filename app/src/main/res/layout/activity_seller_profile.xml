<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F8F7F2">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/btnSellerBack" android:layout_width="48dp" android:layout_height="48dp"
            android:text="‹" android:contentDescription="Quay lại" android:gravity="center" android:textSize="30sp"
            android:textColor="#173B32" android:background="@drawable/bg_white_card_rounded" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Hồ sơ người đăng" android:textSize="24sp" android:textColor="#173B32" />
        <TextView android:id="@+id/txtSellerAvatar" android:layout_width="80dp" android:layout_height="80dp"
            android:layout_marginTop="20dp" android:gravity="center" android:text="●" android:textSize="40sp"
            android:textColor="#173B32" android:background="@drawable/bg_green_circle_soft" />
        <TextView android:id="@+id/txtSellerName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="20sp" android:textStyle="bold" android:textColor="#173B32" />
        <TextView android:id="@+id/txtSellerRegion" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="#75857F" />
        <TextView android:id="@+id/txtSellerBio" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="15sp" android:textColor="#173B32" />
        <TextView android:id="@+id/btnReportSeller" android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center_vertical" android:text="⚑ Báo cáo người dùng này" android:textSize="14sp"
            android:textColor="#B95242" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Bài đăng đang hoạt động" android:textSize="18sp"
            android:textStyle="bold" android:textColor="#173B32" />
        <TextView android:id="@+id/txtSellerState" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingVertical="16dp" android:text="Đang tải hồ sơ…" android:textSize="14sp" android:textColor="#75857F" />
        <Button android:id="@+id/btnRetrySeller" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="Thử lại" android:visibility="gone" />
        <GridLayout android:id="@+id/sellerProductGrid" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="2" android:useDefaultMargins="true" />
    </LinearLayout>
</ScrollView>

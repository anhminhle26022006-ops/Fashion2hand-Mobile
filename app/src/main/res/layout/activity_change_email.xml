<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F6F0" android:fillViewport="true" android:clipToPadding="false"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
    <TextView android:id="@+id/btnChangeEmailBack" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginTop="10dp" android:gravity="center" android:text="‹" android:textColor="#173B32" android:textSize="28sp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="CẬP NHẬT TÀI KHOẢN" android:textColor="#E97859" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Đổi email" android:textColor="#102F27" android:textSize="25sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="18dp" android:text="Chúng tôi sẽ gửi liên kết xác nhận đến email mới của bạn." android:textColor="#75857F" android:textSize="10sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email hiện tại" android:textColor="#52645A" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtCurrentEmail" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="5dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="#EDF1EC" android:text="minhanh.demo@email.com" android:textColor="#75857F" android:textSize="10sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Email mới" android:textColor="#173B32" android:textSize="9sp" android:textStyle="bold" />
    <EditText android:id="@+id/edtNewEmail" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="5dp" android:background="@drawable/bg_white_card_rounded" android:hint="name@example.com" android:inputType="textEmailAddress" android:paddingHorizontal="12dp" android:textColor="#173B32" android:textSize="11sp" />
    <Button android:id="@+id/btnContinueChangeEmail" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:backgroundTint="#104536" android:text="Gửi liên kết xác nhận" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
</LinearLayout></ScrollView>

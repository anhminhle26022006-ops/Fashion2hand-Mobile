<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F6F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btnCheckoutBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_white_card_rounded"
            android:text="‹"
            android:textColor="#173B32"
            android:textSize="32sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Thanh toán"
            android:textColor="#173B32"
            android:textSize="16sp" />
        <TextView android:layout_width="44dp" android:layout_height="44dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Delivery address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card_rounded"
                android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Địa chỉ nhận hàng" android:textColor="#26332D" android:textSize="13sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thay đổi" android:textColor="#23795C" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Nguyễn Minh Anh · 090 123 4567" android:textColor="#26332D" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="12 Nguyễn Đình Chiểu, Quận 3, TP. HCM" android:textColor="#75857F" android:textSize="9sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="＋ Thêm địa chỉ mới" android:textColor="#23795C" android:textSize="9sp" />
            </LinearLayout>

            <!-- Product -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card_rounded"
                android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sản phẩm" android:textColor="#26332D" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="54dp" android:layout_height="62dp" android:background="@drawable/bg_image_upload" android:scaleType="centerCrop" android:src="@drawable/img_product_placeholder" android:contentDescription="Ảnh Vintage Denim Jacket" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOR SALE" android:textColor="#23795C" android:textSize="8sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Vintage Denim Jacket" android:textColor="#26332D" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Nữ · size M · Quận 3" android:textColor="#75857F" android:textSize="9sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="120.000 đ" android:textColor="#F05A4F" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Shipping method -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card_rounded"
                android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phương thức vận chuyển" android:textColor="#26332D" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="40dp">
                    <RadioButton android:layout_width="32dp" android:layout_height="32dp" android:minWidth="0dp" android:minHeight="0dp" android:checked="true" android:clickable="false" android:focusable="false" android:buttonTint="#23795C" android:padding="0dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingVertical="4dp" android:paddingEnd="6dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Giao hàng tiêu chuẩn" android:textColor="#26332D" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:text="Đối tác vận chuyển · Dự kiến 2–4 ngày" android:textColor="#75857F" android:textSize="8sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="25.000đ" android:textColor="#173B32" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Payment methods -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="7dp" android:text="Phương thức thanh toán" android:textColor="#26332D" android:textSize="12sp" />
            <RadioGroup
                android:id="@+id/paymentMethods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card_rounded"
                android:padding="12dp">
                <RadioButton android:id="@+id/paymentCod" android:layout_width="match_parent" android:layout_height="52dp" android:minHeight="0dp" android:layout_marginBottom="5dp" android:gravity="center_vertical" android:includeFontPadding="false" android:background="@drawable/bg_white_card_rounded" android:buttonTint="#23795C" android:paddingHorizontal="8dp" android:text="Thẻ&#10;Thông tin thanh toán được bảo vệ và che" android:textColor="#26332D" android:textSize="9sp" android:lineSpacingExtra="3dp" />
                <RadioButton android:id="@+id/paymentWallet" android:layout_width="match_parent" android:layout_height="52dp" android:minHeight="0dp" android:layout_marginBottom="5dp" android:gravity="center_vertical" android:includeFontPadding="false" android:checked="true" android:background="@drawable/bg_green_light_card" android:buttonTint="#23795C" android:paddingHorizontal="8dp" android:text="Ví điện tử&#10;Thông tin thanh toán được bảo vệ và che" android:textColor="#26332D" android:textSize="9sp" android:lineSpacingExtra="3dp" />
                <RadioButton android:id="@+id/paymentTransfer" android:layout_width="match_parent" android:layout_height="52dp" android:minHeight="0dp" android:layout_marginBottom="5dp" android:gravity="center_vertical" android:includeFontPadding="false" android:background="@drawable/bg_white_card_rounded" android:buttonTint="#23795C" android:paddingHorizontal="8dp" android:text="Chuyển khoản&#10;Thông tin thanh toán được bảo vệ và che" android:textColor="#26332D" android:textSize="9sp" android:lineSpacingExtra="3dp" />
                <RadioButton android:id="@+id/paymentApi" android:layout_width="match_parent" android:layout_height="52dp" android:minHeight="0dp" android:gravity="center_vertical" android:includeFontPadding="false" android:background="@drawable/bg_white_card_rounded" android:buttonTint="#23795C" android:paddingHorizontal="8dp" android:text="Payment API&#10;Đã tích hợp xử lý đơn · chưa kết nối thật" android:textColor="#26332D" android:textSize="9sp" android:lineSpacingExtra="3dp" />
            </RadioGroup>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="vertical" android:background="@drawable/bg_white_card_rounded" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tóm tắt đơn hàng" android:textColor="#26332D" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Tạm tính                                      120.000đ" android:textColor="#75857F" android:textSize="10sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Phí vận chuyển                             25.000đ" android:textColor="#75857F" android:textSize="10sp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="9dp" android:background="#E9EDE9" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tổng thanh toán                           145.000đ" android:textColor="#173B32" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnPlaceOrder"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#23795C"
        android:text="Đặt hàng · 145.000đ"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>

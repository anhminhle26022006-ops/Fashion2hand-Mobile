<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:orientation="horizontal">
        <TextView android:id="@+id/btnCheckoutBack" android:layout_width="44dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textColor="#173B32" android:textSize="32sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Thanh toán" android:textColor="#173B32" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="44dp" android:layout_height="48dp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ĐỊA CHỈ NHẬN HÀNG" android:textColor="#75857F" android:textSize="12sp" android:textStyle="bold" android:paddingBottom="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_white_card_rounded" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nguyễn Minh Anh  ·  0901 234 567" android:textColor="#173B32" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="12 Nguyễn Huệ, Bến Nghé, Quận 1, TP. Hồ Chí Minh" android:textColor="#75857F" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="＋  Thay đổi địa chỉ" android:textColor="#23795C" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PHƯƠNG THỨC THANH TOÁN" android:textColor="#75857F" android:textSize="12sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="8dp" />
            <RadioGroup android:id="@+id/paymentMethods" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_white_card_rounded" android:paddingHorizontal="12dp">
                <RadioButton android:id="@+id/paymentCod" android:layout_width="match_parent" android:layout_height="52dp" android:checked="true" android:buttonTint="#23795C" android:text="Thanh toán khi nhận hàng (COD)" android:textColor="#26332D" android:textSize="14sp" />
                <RadioButton android:id="@+id/paymentTransfer" android:layout_width="match_parent" android:layout_height="52dp" android:buttonTint="#23795C" android:text="Chuyển khoản ngân hàng" android:textColor="#26332D" android:textSize="14sp" />
                <RadioButton android:id="@+id/paymentWallet" android:layout_width="match_parent" android:layout_height="52dp" android:buttonTint="#23795C" android:text="Ví điện tử" android:textColor="#26332D" android:textSize="14sp" />
            </RadioGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TÓM TẮT ĐƠN HÀNG" android:textColor="#75857F" android:textSize="12sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_white_card_rounded" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vintage Denim Jacket  ·  120.000đ" android:textColor="#26332D" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Quần jeans ống rộng  ·  85.000đ" android:textColor="#26332D" android:textSize="14sp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#E9EDE9" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tạm tính                         205.000đ" android:textColor="#75857F" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Phí vận chuyển                  25.000đ" android:textColor="#75857F" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Tổng thanh toán                230.000đ" android:textColor="#173B32" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/btnPlaceOrder" android:layout_width="match_parent" android:layout_height="52dp" android:layout_margin="16dp" android:backgroundTint="#23795C" android:text="Đặt hàng · 230.000đ" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/f2h_bg"
    android:orientation="vertical">

    <include layout="@layout/view_admin_backbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AdminSectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Danh mục sản phẩm" />

                <TextView
                    android:id="@+id/btnAdminAddCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="+ Thêm"
                    android:textColor="@color/f2h_primary_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAdminCategories"
                style="@style/AdminCard" />

            <TextView
                style="@style/AdminSectionTitle"
                android:text="Quy tắc kiểm duyệt" />

            <LinearLayout style="@style/AdminCard">

                <include
                    android:id="@+id/rowSettingAutoHide"
                    layout="@layout/item_admin_switch_row" />

                <include
                    android:id="@+id/rowSettingThreshold"
                    layout="@layout/item_admin_input_row" />

                <include
                    android:id="@+id/rowSettingCompleteDays"
                    layout="@layout/item_admin_input_row" />

                <include
                    android:id="@+id/rowSettingMaxPrice"
                    layout="@layout/item_admin_input_row" />

                <include
                    android:id="@+id/rowSettingRequirePhone"
                    layout="@layout/item_admin_switch_row" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/f2h_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/f2h_bg"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnAdminSaveSettings"
            style="@style/AdminButton"
            android:background="@drawable/bg_admin_btn_primary"
            android:text="Lưu thay đổi"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0">
<LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical"><TextView android:id="@+id/btnPrivacySecurityBack" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="28sp" android:clickable="true" android:focusable="true"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quyền riêng tư và bảo mật" android:textSize="18sp" android:textColor="#173B32"/></LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Thông tin liên hệ từ Firebase Authentication" android:textColor="#173B32" android:textSize="14sp"/>
<TextView android:id="@+id/txtPrivacyEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Đang kiểm tra email…" android:textColor="#173B32" android:textSize="14sp"/>
<Button android:id="@+id/btnPrivacyEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Đổi email / xác minh email" android:textAllCaps="false"/>
<TextView android:id="@+id/txtPrivacyPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Đang kiểm tra số điện thoại…" android:textColor="#173B32" android:textSize="14sp"/>

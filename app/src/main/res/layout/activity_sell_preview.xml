 </LinearLayout></ScrollView><Button android:id="@+id/btnPublishListing" android:layout_width="match_parent" android:layout_height="54dp" android:layout_margin="16dp" android:backgroundTint="#14513E" android:text="Xuất bản tin đăng" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>

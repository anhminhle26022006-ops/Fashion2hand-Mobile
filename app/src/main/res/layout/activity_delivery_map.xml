<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F7F2">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <TextView android:id="@+id/btnMapBack" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="#183C32" android:textSize="30sp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Theo dõi trên bản đồ" android:textColor="#183C32" android:textSize="15sp" android:textStyle="bold" />
        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <vn.edu.ueh.thudinh.fashion2hand.DeliveryMapView android:id="@+id/deliveryMapView" android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="12dp" android:background="#FFF6E8" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:text="DEMO TRACKING DATA" android:textColor="#9A682A" android:textSize="7sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_marginStart="12dp" android:layout_marginBottom="22dp" android:orientation="vertical" android:padding="9dp" android:background="@drawable/bg_white_card_rounded"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▣  Điểm lấy hàng" android:textColor="#183C32" android:textSize="8sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Khu vực Bình Thạnh" android:textColor="#87938D" android:textSize="7sp"/></LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical|end" android:layout_marginEnd="11dp" android:orientation="vertical" android:padding="9dp" android:background="@drawable/bg_white_card_rounded"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▣  Vị trí gần nhất" android:textColor="#183C32" android:textSize="8sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Trung tâm Quận 1" android:textColor="#87938D" android:textSize="7sp"/></LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginEnd="12dp" android:layout_marginTop="38dp" android:orientation="vertical" android:padding="9dp" android:background="@drawable/bg_white_card_rounded"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◎  Điểm giao gần đúng" android:textColor="#183C32" android:textSize="8sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Khu vực Quận 3" android:textColor="#87938D" android:textSize="7sp"/></LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingTop="13dp" android:paddingBottom="14dp" android:background="@drawable/bg_white_card_rounded">
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="9dp" android:background="#EDF4EF"><TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="▣" android:textColor="#104536" android:textSize="18sp" android:background="#FFFFFF"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ĐANG VẬN CHUYỂN" android:textColor="#25815C" android:textSize="7sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Kiện hàng đang đến khu vực giao" android:textColor="#183C32" android:textSize="9sp" android:textStyle="bold"/></LinearLayout></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mã vận đơn" android:textColor="#87938D" android:textSize="8sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRK123456789" android:textColor="#183C32" android:textSize="8sp" android:textStyle="bold"/></LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E7EAE5"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dự kiến đến" android:textColor="#87938D" android:textSize="8sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ngày mai · 14:00–16:00" android:textColor="#183C32" android:textSize="8sp" android:textStyle="bold"/></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:text="◉  Chỉ hiển thị vị trí gần đúng; bản đồ dùng dữ liệu minh họa." android:textColor="#8B9890" android:textSize="7sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F7F2">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingHorizontal="12dp"><TextView android:id="@+id/btnVerificationStatusBack" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="#183C32" android:textSize="30sp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Trạng thái xác minh" android:textColor="#183C32" android:textSize="15sp" android:textStyle="bold"/><View android:layout_width="40dp" android:layout_height="40dp"/></LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="18dp" android:background="#EDF4EF"><TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="◷" android:textColor="#104536" android:textSize="27sp" android:background="#FFFFFF"/><TextView android:id="@+id/txtVerificationStatusTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Hồ sơ đang được xem xét" android:textColor="#183C32" android:textSize="15sp" android:textStyle="bold"/><TextView android:id="@+id/txtVerificationStatusDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Chúng tôi sẽ thông báo kết quả trong mục thông báo. Thời gian xử lý dự kiến: 1–2 ngày làm việc." android:textColor="#718078" android:textSize="9sp"/></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:orientation="vertical" android:paddingHorizontal="12dp" android:background="@drawable/bg_white_card_rounded">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trạng thái" android:textColor="#87938D" android:textSize="9sp"/><TextView android:id="@+id/txtVerificationStatusValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang chờ duyệt" android:textColor="#A26A1D" android:textSize="9sp" android:textStyle="bold"/></LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9ECE7"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Người gửi" android:textColor="#87938D" android:textSize="9sp"/><TextView android:id="@+id/txtVerificationLegalName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nguyễn Minh Anh" android:textColor="#263B32" android:textSize="9sp" android:textStyle="bold"/></LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9ECE7"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Giấy tờ" android:textColor="#87938D" android:textSize="9sp"/><TextView android:id="@+id/txtVerificationDocumentType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CCCD gắn chip" android:textColor="#263B32" android:textSize="9sp" android:textStyle="bold"/></LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9ECE7"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mã hồ sơ" android:textColor="#87938D" android:textSize="9sp"/><TextView android:id="@+id/txtVerificationCaseNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VER-2026-00128" android:textColor="#263B32" android:textSize="9sp" android:textStyle="bold"/></LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:padding="11dp" android:background="#FFF5E6" android:text="Trong thời gian xét duyệt, bạn vẫn dùng được các tính năng cơ bản. Nếu ảnh giấy tờ chưa rõ, hồ sơ có thể được yêu cầu bổ sung." android:textColor="#8C744F" android:textSize="8sp"/>
        <Button android:id="@+id/btnVerificationStatusProfile" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="12dp" android:backgroundTint="#104536" android:text="Về hồ sơ" android:textAllCaps="false" android:textColor="#FFFFFF"/>
    </LinearLayout></ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F8F7F2">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingHorizontal="14dp">
        <TextView android:id="@+id/btnOrdersBack" android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="‹" android:textColor="#183C32" android:textSize="30sp"
            android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="Đơn hàng của tôi" android:textColor="#183C32"
            android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/btnTransactionHistory" android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="↻" android:textColor="#23795C" android:textSize="21sp"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginHorizontal="16dp"
        android:orientation="horizontal" android:background="#E9EEEA" android:padding="4dp">
        <LinearLayout android:id="@+id/tabBuyer" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="10dp" android:background="@drawable/bg_white_card_rounded"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center"
                android:text="⬡" android:textColor="#FFFFFF" android:textSize="16sp" android:background="@drawable/bg_circle_primary" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đơn mua / nhận" android:textColor="#183C32" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buyer · Receiver" android:textColor="#8A968F" android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/tabSeller" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="10dp" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center"
                android:text="▣" android:textColor="#638075" android:textSize="15sp" android:background="#F6F8F6" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đơn bán / cho" android:textColor="#62736A" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seller · Giver" android:textColor="#8A968F" android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <EditText android:id="@+id/edtOrderSearch" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@drawable/bg_white_card_rounded" android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp" android:hint="Tìm mã đơn / sản phẩm" android:inputType="text"
            android:paddingHorizontal="14dp" android:textColor="#183C32" android:textColorHint="#9AA39E" android:textSize="12sp" />
        <TextView android:id="@+id/btnOrderAdvancedFilter" android:layout_width="42dp" android:layout_height="42dp"
            android:layout_marginStart="8dp" android:gravity="center" android:text="☷" android:textColor="#104536"
            android:textSize="21sp" android:background="#E8F1EB" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp"
        android:scrollbars="none" android:paddingStart="16dp" android:paddingEnd="16dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/filterOrdersAll" android:layout_width="wrap_content" android:layout_height="30dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_chip_selected" android:text="Tất cả" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/filterOrdersUnpaid" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_chip_idle" android:text="Chờ thanh toán" android:textColor="#26332D" android:textSize="10sp" />
            <TextView android:id="@+id/filterOrdersConfirm" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_chip_idle" android:text="Chờ xác nhận" android:textColor="#26332D" android:textSize="10sp" />
            <TextView android:id="@+id/filterOrdersPrepare" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_chip_idle" android:text="Đang chuẩn bị" android:textColor="#26332D" android:textSize="10sp" />
            <TextView android:id="@+id/filterOrdersShipping" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_chip_idle" android:text="Đang giao" android:textColor="#26332D" android:textSize="10sp" />
            <TextView android:id="@+id/filterOrdersDone" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_chip_idle" android:text="Đã giao" android:textColor="#26332D" android:textSize="10sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="2dp" android:background="#E5E9E4" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="13dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/txtOrderListSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ĐƠN ĐẾN" android:textColor="#E97859" android:textSize="9sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal">
                        <TextView android:id="@+id/txtOrderCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#183C32" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" đơn hàng" android:textColor="#183C32" android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mới nhất  ›" android:textColor="#95A099" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/orderCard1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_white_card_rounded" android:padding="11dp" android:layout_marginBottom="10dp" android:tag="buyer|shipping|ord10283 vintage denim jacket lan chi">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#E3F0E7" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:text="FREE" android:textColor="#104536" android:textSize="8sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="#ORD10248 · 20/09/2026" android:textColor="#99A39D" android:textSize="8sp" />
                    <TextView android:id="@+id/txtOrderStatusCard3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Đã giao" android:textColor="#23795C" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="72dp" android:layout_height="78dp" android:gravity="center" android:background="#E9DED4" android:text="👗" android:textSize="37sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Váy hoa vintage" android:textColor="#233B32" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Người bán: Thảo Vy" android:textColor="#8D9991" android:textSize="9sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="0đ  ·  Phí ship 25.000đ" android:textColor="#8D9991" android:textSize="9sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tổng 25.000đ" android:textColor="#E97859" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <include layout="@layout/item_order_list_status_row" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:paddingTop="8dp"><TextView android:id="@+id/btnOrderDetail3" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:paddingHorizontal="12dp" android:text="Xem đơn" android:textColor="#104536" android:textSize="10sp" android:textStyle="bold" android:clickable="true" android:focusable="true" /></LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/orderCard4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_white_card_rounded" android:padding="11dp" android:layout_marginBottom="10dp" android:tag="seller|prepare|ord10304 ao khoac denim minh anh" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#104536" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:text="PURCHASE" android:textColor="#FFFFFF" android:textSize="7sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="#ORD10304 · 30/09/2026" android:textColor="#99A39D" android:textSize="8sp" /><TextView android:id="@+id/txtOrderStatusCard4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Đang chuẩn bị" android:textColor="#23795C" android:textSize="9sp" /></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="72dp" android:layout_height="78dp" android:gravity="center" android:background="#E9DED4" android:text="🧥" android:textSize="37sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Áo khoác denim" android:textColor="#233B32" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Người mua: Minh Anh" android:textColor="#8D9991" android:textSize="9sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="120.000đ  ·  Phí ship 25.000đ" android:textColor="#8D9991" android:textSize="9sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bạn nhận 120.000đ" android:textColor="#E97859" android:textSize="11sp" android:textStyle="bold" /></LinearLayout></LinearLayout>
                <include layout="@layout/item_order_list_status_row" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:paddingTop="8dp"><TextView android:id="@+id/btnOrderDetail4" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:paddingHorizontal="12dp" android:text="Xem đơn" android:textColor="#104536" android:textSize="10sp" android:textStyle="bold" android:clickable="true" android:focusable="true" /></LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/orderCard5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_white_card_rounded" android:padding="11dp" android:layout_marginBottom="10dp" android:tag="seller|shipping|ord10299 vay hoa vintage thao vy" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#E3F0E7" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:text="FREE" android:textColor="#104536" android:textSize="8sp" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="#ORD10299 · 29/09/2026" android:textColor="#99A39D" android:textSize="8sp" /><TextView android:id="@+id/txtOrderStatusCard5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Đang giao" android:textColor="#23795C" android:textSize="9sp" /></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="72dp" android:layout_height="78dp" android:gravity="center" android:background="#E9DED4" android:text="👗" android:textSize="37sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Váy hoa vintage" android:textColor="#233B32" android:textSize="12sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Người nhận: Thảo Vy" android:textColor="#8D9991" android:textSize="9sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Miễn phí  ·  Phí ship do người nhận trả" android:textColor="#8D9991" android:textSize="9sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đang vận chuyển" android:textColor="#E97859" android:textSize="11sp" android:textStyle="bold" /></LinearLayout></LinearLayout>
                <include layout="@layout/item_order_list_status_row" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:paddingTop="8dp"><TextView android:id="@+id/btnOrderDetail5" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:paddingHorizontal="12dp" android:text="Xem đơn" android:textColor="#104536" android:textSize="10sp" android:textStyle="bold" android:clickable="true" android:focusable="true" /></LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/txtOrdersEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="28dp" android:gravity="center" android:text="Không tìm thấy đơn hàng phù hợp." android:textColor="#89948E" android:textSize="13sp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

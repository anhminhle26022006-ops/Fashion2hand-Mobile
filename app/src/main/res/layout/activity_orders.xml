            </LinearLayout>
            <LinearLayout android:id="@+id/orderCard3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_white_card_rounded" android:padding="11dp" android:layout_marginBottom="10dp" android:tag="buyer|done|ord10248 vay hoa vintage thao vy">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_green_light_card" android:padding="13dp" android:text="Fashion2hand · Hỗ trợ người dùng\nThời gian phản hồi dự kiến: trong vòng 1 ngày làm việc." android:textColor="#52665B" android:textSize="10sp"/>

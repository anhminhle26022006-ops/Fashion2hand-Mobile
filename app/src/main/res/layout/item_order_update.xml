<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_card_rounded"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_box"
                app:tint="#273E29" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CẬP NHẬT ĐƠN HÀNG"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#888888" />

                <TextView
                    android:id="@+id/tvOrderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đơn #FH20260928001 đang được giao"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#111111" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTrackOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theo dõi"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#273E29" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderSubInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dự kiến giao hôm nay, 14:00–18:00"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>
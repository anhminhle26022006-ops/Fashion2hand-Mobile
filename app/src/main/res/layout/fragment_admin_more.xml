<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/f2h_bg"
    android:orientation="vertical">

    <include layout="@layout/view_admin_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                style="@style/AdminCard"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:showDividers="none">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_admin_circle"
                    android:backgroundTint="@color/f2h_primary_soft"
                    android:gravity="center"
                    android:text="AD"
                    android:textColor="@color/f2h_primary_light"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtMoreAdminName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/f2h_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMoreAdminEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/f2h_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtMoreAdminRole"
                    style="@style/AdminChip" />
            </LinearLayout>

            <TextView
                style="@style/AdminSectionTitle"
                android:text="Kiểm duyệt" />

            <LinearLayout style="@style/AdminCard">

                <include
                    android:id="@+id/rowMoreReports"
                    layout="@layout/item_admin_menu_row" />

                <include
                    android:id="@+id/rowMoreDisputes"
                    layout="@layout/item_admin_menu_row" />

                <include
                    android:id="@+id/rowMoreVerify"
                    layout="@layout/item_admin_menu_row" />
            </LinearLayout>

            <TextView
                style="@style/AdminSectionTitle"
                android:text="Tài chính và hệ thống" />

            <LinearLayout style="@style/AdminCard">

                <include
                    android:id="@+id/rowMoreTransactions"
                    layout="@layout/item_admin_menu_row" />

                <include
                    android:id="@+id/rowMoreSettings"
                    layout="@layout/item_admin_menu_row" />

                <include
                    android:id="@+id/rowMoreLogout"
                    layout="@layout/item_admin_menu_row" />
            </LinearLayout>

            <TextView
                style="@style/AdminSectionTitle"
                android:text="Chế độ demo" />

            <LinearLayout style="@style/AdminCard">

                <include
                    android:id="@+id/rowMoreSimulateError"
                    layout="@layout/item_admin_switch_row" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Trạng thái rỗng xuất hiện khi tìm kiếm hoặc lọc không có kết quả. Trạng thái đang tải hiện mỗi lần mở danh sách."
                android:textColor="@color/f2h_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chào buổi sáng" android:textSize="12sp" android:textColor="#596B64"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minh Anh 👋" android:textSize="22sp" android:textStyle="bold" android:textColor="#173B32"/>
                </LinearLayout>
                <TextView android:id="@+id/btnNotificationsHome" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:minHeight="48dp" android:gravity="center" android:text="♧" android:textSize="22sp" android:textColor="#216B50" android:background="#EAF3ED" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/btnCartHome" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:minHeight="48dp" android:gravity="center" android:text="🛍" android:textSize="20sp" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cho quần áo một vòng đời mới." android:textSize="13sp" android:textColor="#596B64" android:layout_marginBottom="12dp"/>
            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:hint="⌕  Tìm quần áo..."
                android:textSize="12sp"
                android:singleLine="true"
                android:background="#F4F4F6"
                android:paddingStart="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="#E2F1E6">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="THỜI TRANG TUẦN HOÀN  ·  CỘNG ĐỒNG" android:textSize="9sp" android:textStyle="bold" android:textColor="#216B50"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trao đồ cũ, mở ra những câu chuyện mới." android:textSize="20sp" android:textStyle="bold" android:textColor="#173B32" android:layout_marginTop="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tìm món đồ vừa túi tiền hoặc chia sẻ món đồ bạn không còn dùng." android:textSize="12sp" android:textColor="#42605A" android:layout_marginTop="6dp"/>
                <Button android:id="@+id/btnExploreHero" android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp" android:text="Khám phá ngay  →" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#216B50" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Danh mục"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#173B32"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả"
                    android:textSize="11sp"
                    android:textColor="#17795B"/>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAll"
                        android:layout_width="52dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="Tất cả"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#216B50"
                        android:layout_marginEnd="7dp"/>

                    <TextView
                        android:id="@+id/btnAo"
                        android:layout_width="45dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="Áo"
                        android:textSize="11sp"
                        android:textColor="#42605A"
                        android:background="#F7F7F7"
                        android:layout_marginEnd="7dp"/>

                    <TextView
                        android:id="@+id/btnQuan"
                        android:layout_width="55dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="Quần"
                        android:textSize="11sp"
                        android:textColor="#42605A"
                        android:background="#F7F7F7"
                        android:layout_marginEnd="7dp"/>

                    <TextView
                        android:id="@+id/btnVay"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="Váy"
                        android:textSize="11sp"
                        android:textColor="#42605A"
                        android:background="#F7F7F7"/>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mới đăng"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#173B32"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 bài"
                    android:textSize="10sp"
                    android:textColor="#666666"/>
            </LinearLayout>

            <GridLayout
                android:id="@+id/productGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="175dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:id="@+id/productCard1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="105dp"
                        android:background="#D7F2DC">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="👕"
                            android:textSize="40sp"/>

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="top|end"
                            android:gravity="center"
                            android:text="♡"
                            android:textSize="18sp"
                            android:textColor="#5F706A"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Áo thun basic"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#273B38"
                        android:padding="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Size M • Tốt"
                        android:textSize="9sp"
                        android:textColor="#5F706A"
                        android:paddingStart="6dp"/>

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:text="Miễn phí"
                        android:textSize="9sp"
                        android:textColor="#176B4C"
                        android:background="#DDF4E7"
                        android:layout_margin="6dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="175dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:id="@+id/productCard2">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="105dp"
                        android:background="#E0D5F5">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="👗"
                            android:textSize="40sp"/>

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="top|end"
                            android:gravity="center"
                            android:text="♡"
                            android:textSize="18sp"
                            android:textColor="#5F706A"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Váy hoa vintage"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#273B38"
                        android:padding="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Size S • Rất tốt"
                        android:textSize="9sp"
                        android:textColor="#5F706A"
                        android:paddingStart="6dp"/>

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:text="Miễn phí"
                        android:textSize="9sp"
                        android:textColor="#176B4C"
                        android:background="#DDF4E7"
                        android:layout_margin="6dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="175dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:id="@+id/productCard3">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="105dp"
                        android:background="#DCE9F7">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="👖"
                            android:textSize="40sp"/>

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="top|end"
                            android:gravity="center"
                            android:text="♡"
                            android:textSize="18sp"
                            android:textColor="#5F706A"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quần jeans xanh"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#273B38"
                        android:padding="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Size L • Tốt"
                        android:textSize="9sp"
                        android:textColor="#5F706A"
                        android:paddingStart="6dp"/>

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:text="Miễn phí"
                        android:textSize="9sp"
                        android:textColor="#176B4C"
                        android:background="#DDF4E7"
                        android:layout_margin="6dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="175dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:id="@+id/productCard4">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="105dp"
                        android:background="#F5EAD7">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="🥼"
                            android:textSize="40sp"/>

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="top|end"
                            android:gravity="center"
                            android:text="♡"
                            android:textSize="18sp"
                            android:textColor="#5F706A"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Áo khoác denim"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#273B38"
                        android:padding="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Size M • Tốt"
                        android:textSize="9sp"
                        android:textColor="#5F706A"
                        android:paddingStart="6dp"/>

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:text="Miễn phí"
                        android:textSize="9sp"
                        android:textColor="#176B4C"
                        android:background="#DDF4E7"
                        android:layout_margin="6dp"/>
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:background="#FFFFFF" android:elevation="8dp">
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textSize="21sp" android:textColor="#216B50"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textSize="9sp" android:textColor="#216B50"/></LinearLayout>
        <LinearLayout android:id="@+id/navExplore" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌕" android:textSize="21sp" android:textColor="#216B50"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khám phá" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout>
        <LinearLayout android:id="@+id/navCreate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋" android:textSize="21sp" android:textColor="#216B50"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đăng bán" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout>
        <LinearLayout android:id="@+id/navMessages" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✉" android:textSize="21sp" android:textColor="#216B50"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tin nhắn" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout>
        <LinearLayout android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☺" android:textSize="21sp" android:textColor="#216B50"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cá nhân" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout>
    </LinearLayout>
</LinearLayout>

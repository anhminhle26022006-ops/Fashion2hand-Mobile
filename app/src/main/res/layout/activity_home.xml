<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F6F0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/txtHomeGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hi 👋" android:textColor="#173B32" android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Cho quần áo một vòng đời mới." android:textColor="#75857F" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:id="@+id/btnNotificationsHome" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="5dp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:contentDescription="Thông báo" android:focusable="true" android:gravity="center" android:text="♧" android:textColor="#173B32" android:textSize="19sp" />
                <TextView android:id="@+id/btnCartHome" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="5dp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:contentDescription="Giỏ hàng" android:focusable="true" android:gravity="center" android:text="🛒" android:textSize="17sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_home_search"
                android:hint="⌕  Tìm quần áo, thương hiệu, phong cách..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textSize="15sp" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/btnWomenCategory" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_chip_idle" android:gravity="center" android:minWidth="58dp" android:paddingHorizontal="16dp" android:text="Áo" android:textColor="#26332D" android:textSize="11sp" />
                    <TextView android:id="@+id/btnMenCategory" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip_idle" android:gravity="center" android:minWidth="58dp" android:paddingHorizontal="16dp" android:text="Quần" android:textColor="#26332D" android:textSize="11sp" />
                    <TextView android:id="@+id/btnKidsCategory" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip_idle" android:gravity="center" android:minWidth="68dp" android:paddingHorizontal="14dp" android:text="Váy&amp; Đầm" android:textColor="#26332D" android:textSize="11sp" />
                    <TextView android:id="@+id/btnShoesCategory" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip_idle" android:gravity="center" android:minWidth="58dp" android:paddingHorizontal="14dp" android:text="Giày dép" android:textColor="#26332D" android:textSize="11sp" />
                    <TextView android:id="@+id/btnBagsCategory" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip_idle" android:gravity="center" android:minWidth="58dp" android:paddingHorizontal="14dp" android:text="Túi xách" android:textColor="#26332D" android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="188dp" android:layout_marginTop="16dp" android:background="@drawable/bg_home_hero" android:gravity="center_vertical" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TÁI SỬ DỤNG · TIẾT KIỆM · CỘNG ĐỒNG" android:textColor="#DDEBE4" android:textSize="8sp" android:textStyle="bold" />
                <TextView android:layout_width="240dp" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Cho quần áo\nmột vòng đời mới." android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="220dp" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Tìm thời trang vừa túi tiền hoặc chia sẻ món đồ bạn không còn dùng." android:textColor="#E5EEE9" android:textSize="9sp" />
                <Button android:id="@+id/btnExploreHero" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginTop="9dp" android:backgroundTint="#FFFFFF" android:text="Khám phá ngay  ›" android:textAllCaps="false" android:textColor="#14513E" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mới đăng gần đây" android:textColor="#202923" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnSeeAllHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="Xem tất cả" android:textColor="#23795C" android:textSize="10sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/productGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2">

                <LinearLayout android:id="@+id/productCard1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginEnd="6dp" android:background="#FFFFFF" android:orientation="vertical">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="150dp" android:background="#E4F0E8">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="👕" android:textSize="56sp" />
                        <TextView android:id="@+id/likeProduct1" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="#FFFFFF" android:clickable="true" android:focusable="true" android:gravity="center" android:text="♡" android:textColor="#274238" android:textSize="24sp" />
                    </FrameLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Áo thun basic" android:textColor="#202923" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Size M · Tốt" android:textColor="#75857F" android:textSize="13sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="#E4F3EC" android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp" android:text="Miễn phí" android:textColor="#23795C" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/productCard2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginStart="6dp" android:background="#FFFFFF" android:orientation="vertical">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="150dp" android:background="#EEE9F7">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="👗" android:textSize="56sp" />
                        <TextView android:id="@+id/likeProduct2" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="#FFFFFF" android:clickable="true" android:focusable="true" android:gravity="center" android:text="♡" android:textColor="#274238" android:textSize="24sp" />
                    </FrameLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Váy hoa vintage" android:textColor="#202923" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Size S · Rất tốt" android:textColor="#75857F" android:textSize="13sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="#E4F3EC" android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp" android:text="Miễn phí" android:textColor="#23795C" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/productCard3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginTop="18dp" android:layout_marginEnd="6dp" android:background="#FFFFFF" android:orientation="vertical">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="150dp" android:background="#E7EEF8">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="👖" android:textSize="56sp" />
                        <TextView android:id="@+id/likeProduct3" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="#FFFFFF" android:clickable="true" android:focusable="true" android:gravity="center" android:text="♡" android:textColor="#274238" android:textSize="24sp" />
                    </FrameLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Quần jeans xanh" android:textColor="#202923" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Size L · Tốt" android:textColor="#75857F" android:textSize="13sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="#E4F3EC" android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp" android:text="Miễn phí" android:textColor="#23795C" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/productCard4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginStart="6dp" android:layout_marginTop="18dp" android:background="#FFFFFF" android:orientation="vertical">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="150dp" android:background="#F4EBDD">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="🥼" android:textSize="56sp" />
                        <TextView android:id="@+id/likeProduct4" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="#FFFFFF" android:clickable="true" android:focusable="true" android:gravity="center" android:text="♡" android:textColor="#274238" android:textSize="24sp" />
                    </FrameLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Áo khoác denim" android:textColor="#202923" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Size M · Tốt" android:textColor="#75857F" android:textSize="13sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="#E4F3EC" android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp" android:text="120.000đ" android:textColor="#23795C" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_navigation" />
</LinearLayout>

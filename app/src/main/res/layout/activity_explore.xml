<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/exploreRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8FAF8">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fashion2hand" android:textSize="13sp" android:textStyle="bold" android:textColor="#277B5C" android:layout_marginBottom="10dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tìm món đồ tiếp theo" android:textSize="24sp" android:textStyle="bold" android:textColor="#173B32" android:layout_marginBottom="5dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Khám phá thời trang đã qua sử dụng." android:textSize="13sp" android:textColor="#75857F" android:layout_marginBottom="18dp"/>
            <EditText android:id="@+id/edtExploreSearch" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Tìm áo, quần, váy..." android:singleLine="true" android:paddingStart="12dp" android:background="#FFFFFF" android:layout_marginBottom="12dp"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="14dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/filterAll" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Tất cả" android:textColor="#FFFFFF" android:background="#277B5C" android:layout_marginEnd="8dp"/>
<TextView android:id="@+id/filterAo" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Áo" android:textColor="#42605A" android:background="#EAF0EC" android:layout_marginEnd="8dp"/>
<TextView android:id="@+id/filterQuan" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Quần" android:textColor="#42605A" android:background="#EAF0EC" android:layout_marginEnd="8dp"/>
<TextView android:id="@+id/filterVay" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Váy" android:textColor="#42605A" android:background="#EAF0EC"/>
</LinearLayout></HorizontalScrollView>
<TextView android:id="@+id/txtExploreCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sản phẩm gợi ý" android:textSize="14sp" android:textStyle="bold" android:textColor="#173B32" android:layout_marginBottom="8dp"/>
<GridLayout android:id="@+id/exploreProductGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:background="#FFFFFF" android:elevation="8dp"><LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textSize="21sp" android:textColor="#277B5C"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout><LinearLayout android:id="@+id/navExplore" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌕" android:textSize="21sp" android:textColor="#277B5C"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khám phá" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout><LinearLayout android:id="@+id/navCreate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋" android:textSize="21sp" android:textColor="#277B5C"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đăng bán" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout><LinearLayout android:id="@+id/navMessages" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" an
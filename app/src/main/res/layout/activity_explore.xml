<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/exploreRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KHÁM PHÁ" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.1" android:textColor="#E66F55" android:layout_marginBottom="7dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tìm món đồ tiếp theo" android:textSize="24sp" android:textColor="#173B32" android:layout_marginBottom="14dp"/>
            <EditText android:id="@+id/edtExploreSearch" android:layout_width="match_parent" android:layout_height="48dp" android:hint="⌕  Tìm quần áo, thương hiệu, phong cách" android:singleLine="true" android:paddingStart="12dp" android:background="#FFFFFF" android:layout_marginBottom="12dp"/>
<Button android:id="@+id/btnOpenFilterSheet" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="14dp" android:backgroundTint="#14513E" android:text="☷  Bộ lọc" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
<TextView android:id="@+id/txtExploreCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sản phẩm gợi ý" android:textSize="14sp" android:textStyle="bold" android:textColor="#173B32" android:layout_marginBottom="8dp"/>
<GridLayout android:id="@+id/exploreProductGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:background="#FFFFFF" android:elevation="8dp"><LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textSize="21sp" android:textColor="#277B5C"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout><LinearLayout android:id="@+id/navExplore" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌕" android:textSize="21sp" android:textColor="#277B5C"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khám phá" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout><LinearLayout android:id="@+id/navCreate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋" android:textSize="21sp" android:textColor="#277B5C"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đăng bán" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout><LinearLayout android:id="@+id/navMessages" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✉" android:textSize="21sp" android:textColor="#277B5C"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tin nhắn" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout><LinearLayout android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☺" android:textSize="21sp" android:textColor="#277B5C"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cá nhân" android:textSize="9sp" android:textColor="#42605A"/></LinearLayout></LinearLayout>
</LinearLayout>

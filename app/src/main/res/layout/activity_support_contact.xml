<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0">
<LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical"><TextView android:id="@+id/btnSupportContactBack" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="28sp" android:clickable="true" android:focusable="true"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Liên hệ hỗ trợ" android:textSize="18sp" android:textColor="#173B32"/></LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Gửi yêu cầu đến quản trị viên. Mã yêu cầu, trạng thái và phản hồi được lưu trong hệ thống." android:textColor="#173B32" android:textSize="14sp"/>
<EditText android:id="@+id/edtSupportTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Tiêu đề yêu cầu" android:inputType="textCapSentences" android:maxLength="160"/>
<EditText android:id="@+id/edtSupportDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Mô tả vấn đề cần hỗ trợ" android:inputType="textCapSentences|textMultiLine" android:minLines="4" android:maxLength="3000"/>
<Button android:id="@+id/btnSendSupport" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Gửi yêu cầu hỗ trợ" android:textAllCaps="false"/>
<TextView android:id="@+id/txtSupportStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Đang tải lịch sử yêu cầu…" android:textColor="#173B32" android:textSize="14sp"/>
</LinearLayout></ScrollView></LinearLayout>

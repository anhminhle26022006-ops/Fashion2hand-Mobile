                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="support@fashion2hand.example" android:textColor="#173B32" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Email minh họa · chưa kết nối hộp thư" android:textColor="#B47B39" android:textSize="8sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:orientation="vertical" android:padding="13dp" android:background="@drawable/bg_green_light_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thời gian hỗ trợ" android:textColor="#173B32" android:textSize="10sp" android:textStyle="bold" />

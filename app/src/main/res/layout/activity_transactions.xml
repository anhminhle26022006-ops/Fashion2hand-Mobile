<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F7F2">
    <include layout="@layout/view_transaction_header"/>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E6E9E3"/>
    <ScrollView android:id="@+id/transactionScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/transactionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="24dp">
            <RadioGroup android:id="@+id/transactionRoleTabs" android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:padding="4dp" android:background="@drawable/bg_transaction_tabs">
                <RadioButton android:id="@+id/tabReceive" style="@style/TransactionSegment" android:text="Nhận / Mua&#10;Yêu cầu và đơn mua" android:checked="true"/>
                <RadioButton android:id="@+id/tabGive" style="@style/TransactionSegment" android:text="Tặng / Bán&#10;Yêu cầu và đơn bán"/>
            </RadioGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="TỔNG QUAN GIAO DỊCH" android:textColor="#C85C41" android:textSize="10sp" android:letterSpacing="0.12"/>
            <TextView android:id="@+id/txtTransactionHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Món đồ bạn đang nhận và mua" android:textColor="#173B32" android:textSize="21sp"/>
            <TextView android:id="@+id/transactionOverviewState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Đang tải giao dịch…" android:textSize="12sp" android:textColor="#65776D"/>
            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="-4dp" android:layout_marginTop="8dp" android:columnCount="2">
                <LinearLayout style="@style/TransactionMetricCard"><TextView android:id="@+id/statPendingRequests" style="@style/TransactionMetricValue"/><TextView style="@style/TransactionCaption" android:text="Yêu cầu đang chờ"/></LinearLayout>
                <LinearLayout style="@style/TransactionMetricCard"><TextView android:id="@+id/statAwaitingPayment" style="@style/TransactionMetricValue"/><TextView style="@style/TransactionCaption" android:text="Cần thanh toán"/></LinearLayout>
                <LinearLayout style="@style/TransactionMetricCard"><TextView android:id="@+id/statShippingOrders" style="@style/TransactionMetricValue"/><TextView style="@style/TransactionCaption" android:text="Đang giao"/></LinearLayout>
                <LinearLayout style="@style/TransactionMetricCard"><TextView android:id="@+id/statDeliveredOrders" style="@style/TransactionMetricValue"/><TextView style="@style/TransactionCaption" android:text="Đã giao"/></LinearLayout>
            </GridLayout>
            <LinearLayout android:id="@+id/transactionRequestRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="112dp" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/bg_transaction_card" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Yêu cầu nhận đồ" android:textColor="#173B32" android:textSize="13sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="10dp" android:background="@drawable/bg_green_light_card" android:src="@drawable/ic_heart" android:tint="#173B32" android:importantForAccessibility="no"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="12dp" android:orientation="vertical"><TextView android:id="@+id/txtRequestPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chưa có yêu cầu nhận đồ" android:textColor="#173B32" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/><TextView android:id="@+id/txtRequestPreviewStatus" style="@style/TransactionCaption" android:text="Xem các yêu cầu của bạn"/></LinearLayout>
                    <TextView android:id="@+id/txtRequestCount" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/bg_circle_primary" android:text="0" android:textSize="11sp" android:textColor="#FFFFFF"/>
                    <TextView android:layout_width="24dp" android:layout_height="36dp" android:gravity="center" android:text="›" android:textColor="#173B32" android:textSize="26sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/freeRequestList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:visibility="gone"/>
            <LinearLayout android:id="@+id/transactionPurchaseRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="112dp" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/bg_transaction_card" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/txtPurchaseSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mua hàng" android:textColor="#173B32" android:textSize="13sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="10dp" android:background="@drawable/bg_green_light_card" android:src="@drawable/ic_box" android:tint="#173B32" android:importantForAccessibility="no"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="12dp" android:orientation="vertical"><TextView android:id="@+id/txtPurchasePreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chưa có đơn hàng" android:textColor="#173B32" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/><TextView android:id="@+id/txtPurchasePreviewStatus" style="@style/TransactionCaption" android:text="Xem đơn mua và nhận đồ"/></LinearLayout>
                    <TextView android:id="@+id/txtPurchaseCount" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/bg_circle_primary" android:text="0" android:textSize="11sp" android:textColor="#FFFFFF"/>
                    <TextView android:layout_width="24dp" android:layout_height="36dp" android:gravity="center" android:text="›" android:textColor="#173B32" android:textSize="26sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/transactionIssueRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="112dp" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/bg_transaction_card" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vấn đề cần chú ý" android:textColor="#173B32" android:textSize="13sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="10dp" android:background="@drawable/bg_green_light_card" android:src="@drawable/ic_shield_check" android:tint="#A86A26" android:importantForAccessibility="no"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="12dp" android:orientation="vertical"><TextView android:id="@+id/txtIssuePreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Không có tranh chấp đang mở" android:textColor="#173B32" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/txtIssuePreviewStatus" style="@style/TransactionCaption" android:text="Các cập nhật cần chú ý sẽ xuất hiện tại đây"/></LinearLayout>
                    <TextView android:id="@+id/txtIssueCount" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/bg_badge_red" android:text="0" android:textSize="11sp" android:textColor="#FFFFFF"/>
                    <TextView android:layout_width="24dp" android:layout_height="36dp" android:gravity="center" android:text="›" android:textColor="#173B32" android:textSize="26sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
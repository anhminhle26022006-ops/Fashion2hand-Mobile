<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="#FFFFFF">
        <TextView android:id="@+id/btnTransactionsBack" android:layout_width="40dp" android:layout_height="42dp" android:gravity="center" android:text="‹" android:textColor="#173B32" android:textSize="30sp" android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Trung tâm giao dịch" android:textColor="#173B32" android:textSize="15sp" android:textStyle="bold" />
        <View android:layout_width="40dp" android:layout_height="1dp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:padding="4dp" android:background="#E8ECE8">
                <Button android:id="@+id/tabReceive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="#FFFFFF" android:text="Nhận / Mua\nYêu cầu và đơn nhận" android:textAllCaps="false" android:textColor="#173B32" android:textSize="9sp" />
                <Button android:id="@+id/tabGive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="#E8ECE8" android:text="Tặng / Bán\nYêu cầu và đơn cho" android:textAllCaps="false" android:textColor="#66756D" android:textSize="9sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:text="TỔNG QUAN GIAO DỊCH" android:textColor="#E97859" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtTransactionHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Món đồ bạn đang nhận và mua" android:textColor="#173B32" android:textSize="19sp" />
            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="2">
                <LinearLayout android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_white_card_rounded"><TextView android:text="2" android:textSize="18sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:text="Yêu cầu đang chờ" android:textSize="8sp" android:textColor="#75857F"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_white_card_rounded"><TextView android:text="1" android:textSize="18sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:text="Cần thanh toán" android:textSize="8sp" android:textColor="#75857F"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_white_card_rounded"><TextView android:text="3" android:textSize="18sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:text="Đang giao" android:textSize="8sp" android:textColor="#75857F"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_white_card_rounded"><TextView android:text="1" android:textSize="18sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:text="Đã giao" android:textSize="8sp" android:textColor="#75857F"/></LinearLayout>
            </GridLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:padding="8dp" android:text="Yêu cầu nhận đồ" android:textColor="#75857F" android:textSize="9sp" />
            <LinearLayout android:id="@+id/transactionRequestRow" android:layout_width="match_parent" android:layout_height="70dp" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true"><TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="♡" android:textColor="#104536" android:textSize="20sp" android:background="@drawable/bg_green_light_card"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:text="Yêu cầu áo blazer màu kem" android:textSize="9sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:layout_marginTop="4dp" android:text="PENDING · Đang chờ người tặng lựa chọn" android:textSize="7sp" android:textColor="#75857F"/></LinearLayout><TextView android:text="2   ›" android:textColor="#104536" android:textSize="12sp"/></LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="8dp" android:text="Mua hàng" android:textColor="#75857F" android:textSize="9sp" />
            <LinearLayout android:id="@+id/transactionPurchaseRow" android:layout_width="match_parent" android:layout_height="70dp" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true"><TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="⬡" android:textColor="#104536" android:textSize="18sp" android:background="@drawable/bg_green_light_card"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:text="Vintage Denim Jacket" android:textSize="9sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:layout_marginTop="4dp" android:text="Đang giao · Payment Holding" android:textSize="7sp" android:textColor="#75857F"/></LinearLayout><TextView android:text="3   ›" android:textColor="#104536" android:textSize="12sp"/></LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="8dp" android:text="Vấn đề cần chú ý" android:textColor="#75857F" android:textSize="9sp" />
            <LinearLayout android:id="@+id/transactionIssueRow" android:layout_width="match_parent" android:layout_height="70dp" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true"><TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="⛨" android:textColor="#B56B20" android:textSize="18sp" android:background="#FFF3E5"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp"><TextView android:text="Tranh chấp đang xem xét" android:textSize="9sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:layout_marginTop="4dp" android:text="Payment Holding · 1 trường hợp" android:textSize="7sp" android:textColor="#75857F"/></LinearLayout><TextView android:text="1   ›" android:textColor="#C84942" android:textSize="12sp"/></LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

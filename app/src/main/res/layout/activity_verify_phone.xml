<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0" android:padding="22dp">
    <TextView android:id="@+id/btnVerifyPhoneBack" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginTop="10dp" android:gravity="center" android:text="‹" android:textColor="#173B32" android:textSize="28sp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="BẢO MẬT TÀI KHOẢN" android:textColor="#E97859" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtVerifyPhoneTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Xác minh số điện thoại" android:textColor="#102F27" android:textSize="25sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="18dp" android:text="Nhập số điện thoại để nhận mã xác thực OTP." android:textColor="#75857F" android:textSize="10sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Số điện thoại" android:textColor="#173B32" android:textSize="9sp" android:textStyle="bold" />
    <EditText android:id="@+id/edtVerifyPhoneNumber" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_white_card_rounded" android:hint="0900 000 000" android:inputType="phone" android:paddingHorizontal="12dp" android:textColor="#173B32" android:textSize="11sp" />
    <Button android:id="@+id/btnSendPhoneOtp" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:backgroundTint="#104536" android:text="Gửi mã OTP" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
</LinearLayout>

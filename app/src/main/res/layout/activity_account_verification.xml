<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F7F2">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingHorizontal="12dp"><TextView android:id="@+id/btnVerificationBack" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="#183C32" android:textSize="30sp" android:background="@drawable/bg_white_card_rounded" android:clickable="true" android:focusable="true"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Xác minh tài khoản" android:textColor="#183C32" android:textSize="15sp" android:textStyle="bold"/><View android:layout_width="40dp" android:layout_height="40dp"/></LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="15dp" android:paddingBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginVertical="5dp" android:orientation="horizontal"><View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#104536"/><View android:layout_width="5dp" android:layout_height="1dp"/><View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#104536"/><View android:layout_width="5dp" android:layout_height="1dp"/><View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#DFE5DF"/></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" android:padding="11dp" android:background="#FFF5E6"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mục đích xác minh" android:textColor="#8F632C" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tăng độ tin cậy, hỗ trợ bảo vệ tài khoản và xử lý tranh chấp. Ảnh giấy tờ chỉ dùng cho quy trình xác minh trong bản demo." android:textColor="#977F5E" android:textSize="8sp" android:lineSpacingExtra="2dp"/></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:layout_marginBottom="8dp" android:text="1. Thông tin trên giấy tờ" android:textColor="#183C32" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Họ và tên pháp lý" android:textColor="#183C32" android:textSize="9sp" android:textStyle="bold"/>
        <EditText android:id="@+id/edtLegalName" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="9dp" android:background="@drawable/bg_white_card_rounded" android:hint="Nhập đúng theo CCCD" android:paddingHorizontal="12dp" android:textColor="#183C32" android:textSize="10sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ngày sinh" android:textColor="#183C32" android:textSize="9sp" android:textStyle="bold"/>
        <EditText android:id="@+id/edtLegalBirthDate" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="9dp" android:background="@drawable/bg_white_card_rounded" android:hint="Ngày / tháng / năm sinh" android:inputType="date" android:paddingHorizontal="12dp" android:textColor="#183C32" android:textSize="10sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loại giấy tờ" android:textColor="#183C32" android:textSize="9sp" android:textStyle="bold"/>
        <Spinner android:id="@+id/spinnerIdentityDocument" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:layout_marginBottom="9dp" android:background="@drawable/bg_white_card_rounded" android:paddingHorizontal="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Số CCCD / giấy tờ" android:textColor="#183C32" android:textSize="9sp" android:textStyle="bold"/>
        <EditText android:id="@+id/edtIdentityNumber" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:background="@drawable/bg_white_card_rounded" android:hint="Nhập số trên giấy tờ" android:inputType="number" android:paddingHorizontal="12dp" android:textColor="#183C32" android:textSize="10sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:layout_marginBottom="8dp" android:text="2. Ảnh xác minh" android:textColor="#183C32" android:textSize="12sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/btnIdentityFront" android:layout_width="0dp" android:layout_height="78dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:backgroundTint="#FFFFFF" android:text="＋\nẢnh mặt trước CCCD" android:textAllCaps="false" android:textColor="#52645A" android:textSize="8sp"/><Button android:id="@+id/btnIdentityBack" android:layout_width="0dp" android:layout_height="78dp" android:layout_weight="1" android:layout_marginStart="4dp" android:backgroundTint="#FFFFFF" android:text="＋\nẢnh mặt sau CCCD" android:textAllCaps="false" android:textColor="#52645A" android:textSize="8sp"/></LinearLayout>
        <Button android:id="@+id/btnIdentitySelfie" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="5dp" android:backgroundTint="#FFFFFF" android:text="＋  Ảnh chân dung cầm giấy tờ" android:textAllCaps="false" android:textColor="#52645A" android:textSize="8sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="5dp" android:text="3. Xác nhận" android:textColor="#183C32" android:textSize="12sp" android:textStyle="bold"/>
        <CheckBox android:id="@+id/checkIdentityAccurate" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#104536" android:text="Tôi xác nhận thông tin cung cấp là chính xác và thuộc về mình." android:textColor="#52645A" android:textSize="8sp"/>
        <CheckBox android:id="@+id/checkIdentityPrivacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#104536" android:text="Tôi đồng ý để Fashion2hand xử lý dữ liệu giấy tờ cho mục đích xác minh." android:textColor="#52645A" android:textSize="8sp"/>
        <Button android:id="@+id/btnSubmitVerification" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:backgroundTint="#104536" android:text="Gửi hồ sơ xác minh" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
        <Button android:id="@+id/btnVerificationLater" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:backgroundTint="#FFFFFF" android:text="Để sau" android:textAllCaps="false" android:textColor="#104536"/>
    </LinearLayout></ScrollView>
</LinearLayout>

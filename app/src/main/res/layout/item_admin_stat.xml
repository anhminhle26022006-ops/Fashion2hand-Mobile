<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_admin_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/txtStatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/f2h_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/f2h_text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txtStatDelta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/f2h_primary_light"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>

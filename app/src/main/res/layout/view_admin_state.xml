<?xml version="1.0" encoding="utf-8"?>
<!-- Trạng thái dùng chung cho mọi danh sách Admin: đang tải / rỗng / lỗi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/progressAdminState"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/f2h_primary_light" />

    <ImageView
        android:id="@+id/imgAdminState"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_admin_circle"
        android:backgroundTint="@color/f2h_primary_soft"
        android:importantForAccessibility="no"
        android:padding="20dp"
        android:src="@drawable/ic_admin_inbox"
        android:tint="@color/f2h_primary_light" />

    <TextView
        android:id="@+id/txtAdminStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/f2h_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtAdminStateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/f2h_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnAdminStateRetry"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_admin_btn_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="Thử lại"
        android:textColor="@color/f2h_primary_light"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F6F0">

    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/btnListingsBack" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textColor="#173B32" android:textSize="30sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TỦ ĐỒ CỦA BẠN" android:textColor="#E66F55" android:textSize="8sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Tin đăng của tôi" android:textColor="#173B32" android:textSize="19sp" />
        </LinearLayout>
        <TextView android:id="@+id/btnCreateListing" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_white_card_rounded" android:gravity="center" android:text="＋" android:textColor="#173B32" android:textSize="24sp" />
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:scrollbars="none">
        <RadioGroup android:id="@+id/listingFilters" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
            <RadioButton android:id="@+id/filterListingAll" android:layout_width="wrap_content" android:layout_height="30dp" android:button="@null" android:checked="true" android:background="@drawable/bg_listing_filter" android:gravity="center" android:minWidth="52dp" android:paddingHorizontal="11dp" android:text="Tất cả" android:textColor="@color/listing_filter_text" android:textSize="9sp" />
            <RadioButton android:id="@+id/filterListingSelling" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:button="@null" android:background="@drawable/bg_listing_filter" android:gravity="center" android:paddingHorizontal="11dp" android:text="Đang bán" android:textColor="@color/listing_filter_text" android:textSize="9sp" />
            <RadioButton android:id="@+id/filterListingPending" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:button="@null" android:background="@drawable/bg_listing_filter" android:gravity="center" android:paddingHorizontal="11dp" android:text="Đã đặt" android:textColor="@color/listing_filter_text" android:textSize="9sp" />
            <RadioButton android:id="@+id/filterListingSold" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:button="@null" android:background="@drawable/bg_listing_filter" android:gravity="center" android:paddingHorizontal="11dp" android:text="Đã bán" android:textColor="@color/listing_filter_text" android:textSize="9sp" />
            <RadioButton android:id="@+id/filterListingGift" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="6dp" android:button="@null" android:background="@drawable/bg_listing_filter" android:gravity="center" android:paddingHorizontal="11dp" android:text="Đã tặng" android:textColor="@color/listing_filter_text" android:textSize="9sp" />
        </RadioGroup>
    </HorizontalScrollView>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/myListingsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingTop="5dp" android:paddingBottom="12dp" />
    </ScrollView>

    <include layout="@layout/bottom_navigation" />
</LinearLayout>

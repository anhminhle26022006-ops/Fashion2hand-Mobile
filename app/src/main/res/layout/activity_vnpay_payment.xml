<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F8F7F1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:fitsSystemWindows="true">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VNPAY Sandbox – thanh toán thử nghiệm" android:textSize="24sp" android:textColor="#124536" android:textStyle="bold" android:layout_marginTop="24dp" />
        <TextView android:id="@+id/vnpayStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="24dp" android:paddingBottom="24dp" android:text="Đang lấy trạng thái từ server…" android:textColor="#124536" android:textSize="17sp" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/vnpayProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <Button android:id="@+id/vnpayOpen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tiếp tục thanh toán VNPAY Sandbox" />
        <Button android:id="@+id/vnpayRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Làm mới trạng thái server" />
        <Button android:id="@+id/vnpayReconcile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đối soát với VNPAY (QueryDR)" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đóng trình duyệt không hủy thanh toán. Kết quả chỉ được xác nhận sau khi server kiểm tra IPN hoặc QueryDR. Không chuyển tiền thật; chưa hỗ trợ hoàn tiền hay trả tiền người bán tự động." android:paddingTop="20dp" android:textColor="#425C52" />
        <Button android:id="@+id/vnpayBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quay lại" />
    </LinearLayout>
</ScrollView>

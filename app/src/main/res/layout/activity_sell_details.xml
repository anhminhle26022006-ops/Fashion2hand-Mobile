<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0">
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:id="@+id/btnSellDetailsBack" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="32sp" android:textColor="#173B32"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BÁN HOẶC TRAO TẶNG" android:textColor="#E66F55" android:textSize="10sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thông tin sản phẩm" android:textColor="#173B32" android:textSize="24sp" android:layout_marginTop="5dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mô tả trung thực giúp xây dựng cộng đồng đáng tin cậy." android:textColor="#75857F" android:textSize="13sp" android:layout_marginTop="6dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tiêu đề" android:textStyle="bold" android:textColor="#173B32" android:layout_marginTop="22dp"/><EditText android:id="@+id/edtProductName" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_form_input" android:hint="Ví dụ: Áo khoác denim vintage" android:paddingHorizontal="14dp" android:singleLine="true" android:layout_marginTop="6dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mô tả" android:textStyle="bold" android:textColor="#173B32" android:layout_marginTop="16dp"/><EditText android:id="@+id/edtProductDescription" android:layout_width="match_parent" android:layout_height="110dp" android:gravity="top" android:background="@drawable/bg_form_input" android:hint="Tình trạng, chất liệu, cách phối..." android:padding="14dp" android:layout_marginTop="6dp" android:inputType="textCapSentences|textMultiLine"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Danh mục" android:textStyle="bold" android:textColor="#173B32" android:layout_marginTop="16dp"/><Spinner android:id="@+id/spinnerCategory" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_form_input" android:paddingHorizontal="12dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kích cỡ" android:textStyle="bold" android:textColor="#173B32" android:layout_marginTop="12dp"/><Spinner android:id="@+id/spinnerSize" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_form_input" android:paddingHorizontal="12dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tình trạng" android:textStyle="bold" android:textColor="#173B32" android:layout_marginTop="12dp"/><Spinner android:id="@+id/spinnerCondition" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_form_input" android:paddingHorizontal="12dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vị trí" android:textStyle="bold" android:textColor="#173B32" android:layout_marginTop="12dp"/><EditText android:id="@+id/edtProductLocation" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_form_input" android:hint="Bình Thạnh, TP.HCM" android:paddingHorizontal="14dp" android:singleLine="true"/>
 </LinearLayout></ScrollView><LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:paddingHorizontal="16dp" android:gravity="center"><Button android:id="@+id/btnSellDetailsNext" android:layout_width="match_parent" android:layout_height="50dp" android:backgroundTint="#14513E" android:text="Tiếp tục" android:textAllCaps="false" android:textColor="#FFFFFF"/></LinearLayout>
</LinearLayout>

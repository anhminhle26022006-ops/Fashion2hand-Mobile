<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F6F0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:background="#FFFFFF">
        <TextView android:id="@+id/btnNotificationsBack" android:layout_width="40dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textSize="26sp" android:textColor="#173B32" android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Thông báo" android:textSize="15sp" android:textColor="#173B32" android:textStyle="bold" />
        <TextView android:id="@+id/btnNotificationsMore" android:layout_width="40dp" android:layout_height="44dp" android:gravity="center" android:text="•••" android:textSize="16sp" android:textColor="#173B32" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="52dp" android:scrollbars="none" android:background="#FFFFFF">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="8dp">
            <TextView android:id="@+id/filterNotifAll" android:tag="all" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:paddingHorizontal="15dp" android:text="Tất cả" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/bg_chip_selected" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/filterNotifOrders" android:tag="orders" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:paddingHorizontal="13dp" android:text="Đơn hàng" android:textSize="10sp" android:textColor="#173B32" android:background="@drawable/bg_chip_idle" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/filterNotifMessages" android:tag="messages" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:paddingHorizontal="13dp" android:text="Tin nhắn" android:textSize="10sp" android:textColor="#173B32" android:background="@drawable/bg_chip_idle" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/filterNotifRequests" android:tag="requests" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:paddingHorizontal="13dp" android:text="Yêu cầu" android:textSize="10sp" android:textColor="#173B32" android:background="@drawable/bg_chip_idle" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/filterNotifPayments" android:tag="payments" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:gravity="center" android:paddingHorizontal="13dp" android:text="Thanh toán" android:textSize="10sp" android:textColor="#173B32" android:background="@drawable/bg_chip_idle" android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingBottom="16dp">
            <LinearLayout android:id="@+id/notifRowFreeRequest" android:tag="requests" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="13dp" android:orientation="horizontal" android:background="#F8F6F0" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="♡" android:textSize="18sp" android:textColor="#174B3A" android:background="#EAF3ED" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Có người yêu cầu món đồ miễn phí của bạn" android:textSize="10sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Mai Phương muốn nhận Áo sơ mi linen trắng." android:textSize="9sp" android:textColor="#75857F"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="5 phút trước" android:textSize="8sp" android:textColor="#89948E"/></LinearLayout>
                <View android:id="@+id/notifUnread1" android:layout_width="7dp" android:layout_height="7dp" android:background="#EF775D" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E3E6E2"/>
            <LinearLayout android:id="@+id/notifRowMessage" android:tag="messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="13dp" android:orientation="horizontal" android:background="#F8F6F0" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="▢" android:textSize="18sp" android:textColor="#174B3A" android:background="#EAF3ED" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bạn có tin nhắn mới" android:textSize="10sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Lan Chi: Vẫn còn bạn nhé." android:textSize="9sp" android:textColor="#75857F"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="18 phút trước" android:textSize="8sp" android:textColor="#89948E"/></LinearLayout>
                <View android:id="@+id/notifUnread2" android:layout_width="7dp" android:layout_height="7dp" android:background="#EF775D" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E3E6E2"/>
            <LinearLayout android:id="@+id/notifRowShipping" android:tag="orders" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="13dp" android:orientation="horizontal" android:background="#F8F6F0" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="▣" android:textSize="17sp" android:textColor="#174B3A" android:background="#EAF3ED" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kiện hàng đang được giao" android:textSize="10sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Đơn #F2H-1028 đã được cập nhật hành trình." android:textSize="9sp" android:textColor="#75857F"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="1 giờ trước" android:textSize="8sp" android:textColor="#89948E"/></LinearLayout>
                <View android:id="@+id/notifUnread3" android:layout_width="7dp" android:layout_height="7dp" android:background="#EF775D" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E3E6E2"/>
            <LinearLayout android:id="@+id/notifRowPayment" android:tag="payments" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="13dp" android:orientation="horizontal" android:background="#F8F6F0" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="⛨" android:textSize="17sp" android:textColor="#174B3A" android:background="#EAF3ED" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thanh toán đang được tạm giữ" android:textSize="10sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="145.000đ được bảo vệ đến khi xác nhận nhận hàng." android:textSize="9sp" android:textColor="#75857F"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Hôm qua" android:textSize="8sp" android:textColor="#89948E"/></LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E3E6E2"/>
            <LinearLayout android:id="@+id/notifRowRequestDone" android:tag="requests" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="13dp" android:orientation="horizontal" android:background="#F8F6F0" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="✓" android:textSize="17sp" android:textColor="#174B3A" android:background="#EAF3ED" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Yêu cầu nhận đồ đã được chấp nhận" android:textSize="10sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Người tặng đang chuẩn bị Áo sơ mi linen trắng." android:textSize="9sp" android:textColor="#75857F"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Hôm qua" android:textSize="8sp" android:textColor="#89948E"/></LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E3E6E2"/>
            <LinearLayout android:id="@+id/notifRowDispute" android:tag="orders" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="13dp" android:orientation="horizontal" android:background="#F8F6F0" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="⚙" android:textSize="17sp" android:textColor="#174B3A" android:background="#EAF3ED" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tranh chấp đã được cập nhật" android:textSize="10sp" android:textStyle="bold" android:textColor="#173B32"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Admin đã tiếp nhận bằng chứng cho đơn hàng của bạn." android:textSize="9sp" android:textColor="#75857F"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="28/09" android:textSize="8sp" android:textColor="#89948E"/></LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
